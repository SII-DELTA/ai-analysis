    "generated_at": {
      "type": "string"
    },
    "data_date": {
      "type": "string"
    },
    "graph_div_id": {
      "type": "string"
    },
    "initial_variant_key": {
      "enum": [
        "effective__effective",
        "effective__raw",
        "blended__effective",
        "blended__raw",
        "effective__tasks_per_hour",
        "blended__tasks_per_hour"
      ]
    },
    "speed_scale": {
      "enum": [
        "log",
        "linear"
      ]
    },
    "artificial_analysis_data_provenance": {
      "$ref": "#/$defs/provenance"
    },
    "cost_metric_definitions": {
      "type": "object",
      "properties": {
        "effective": {
          "$ref": "#/$defs/metricDefinition"
        },
        "blended": {
          "$ref": "#/$defs/metricDefinition"
        }
      },
      "required": [
        "effective",
        "blended"
      ],
      "additionalProperties": false
