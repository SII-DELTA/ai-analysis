{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "完整科学契约 v3",
  "allOf": [
    {
      "$ref": "urn:frontier-3d:model-reference-contract:common"
    },
    {
      "properties": {
        "schema_version": {
          "const": "frontier_3d_visualization_dataset/v3"
        }
      }
    },
    {
      "properties": {
        "metric_variants": {
          "additionalProperties": {
            "properties": {
              "three_dimensional_scene": {
                "properties": {
                  "displayed_model_markers": {
                    "items": {
                      "required": [
                        "x",
                        "y",
                        "z"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "models": {
          "items": {
            "required": [
              "identity_resolution"
            ]
          }
        }
      }
    }
  ]
}
