    "cache_payload_example_scope": "仅为单逻辑副本、主干主缓存加indexer的结构性payload计算；假定上述vLLM布局、完整保留相应上下文、无共享前缀。不是AA测点的已知实际布局，也不适用于未核验的Ascend实现；排除附加项，因此不是所需物理HBM或可实现Agent并发。",
    "topk_storage_warning": "index_topk=1024限制主注意力读取的候选数量，并不表示只存1024个压缩KV；indexer需在保留的压缩池上检索，HCA仍读取其完整压缩流。",
    "reference_code_warning": "官方inference/model.py以BF16张量模拟FP8/FP4量化，注释明确当前实现物理KV用BF16；不能把该参考代码与真实低比特缓存布局混为一谈。",
    "tensor_parallel_warning": "固定版本vLLM的主/索引缓存声明max_tp_shards=1，indexer投影采用复制；物理KV是否跨rank复制必须从实际部署确认，不能将逻辑payload除以TP。"
  },
  "performance_bottleneck_method": {
    "optimistic_step_time_bound": "t_step >= max(F_executed/F_peak_for_matching_precision, B_HBM_transferred/BW_HBM_peak, B_interconnect_transferred/BW_interconnect_peak)，且实际还受依赖、通信延迟、kernel与调度开销影响；混合精度需按实际执行算子分别记账。",
    "compute_warning": "49B激活参数是结构规模，不能直接当作每token精确FLOPs。注意力、indexer、压缩、mHC、DSpark draft/verify、batch padding和prefill均需纳入执行计数。峰值计算比例不能换算Agent并发。",
    "hbm_warning": "不能把每个token激活专家参数的全部字节当作必经HBM流量。一个batch可复用专家权重，多个token可命中相同专家，cache也能复用；须测量HBM字节，或明确batch、专家路由并集、重读和缓存假设。",
    "expert_union_illustration": "在一个batch有B个token且每token选6个routed experts时，每层所触达的不同routed专家数介于6和min(384,6B)之间；该集合仍不足以确定HBM传输字节，因为加载、驻留与重读取决于实现。",
    "interconnect_warning": "EP路由分发/合并、TP归约、跨节点与P/D传输的开销受拓扑和消息大小影响；带宽峰值不能替代全栈实测，all-to-all延迟与负载不均衡可先于峰值成为瓶颈。",
    "agent_trace_warning": "Agent并发须来自相同轨迹的活跃会话定义与SLO测点。平均输出吞吐与按请求分位数的速度/TTFT不是同一统计量，不能以总token/s除20或60生成并发。"
  },
  "power_and_concurrency_break_even_curves": {
    "efficiency_formula": "E = 1000000*C/P_total_w，单位为Agent/MW；C仅取满足目标SLO的已测并发，P_total_w为同一测点全部参与加速器的平均负载功耗。",
    "reference_efficiency_symbol": "E_ref由对应模型、轨迹与SLO的实测基准提供；20/60 token/s两档各一条线。",
    "curve_total_power": "C_equal(P_total_w) = E_ref*P_total_w/1000000。",
    "curve_per_module_power": "若有n个物理模组且每模组平均功耗为p_w，则C_equal(n,p_w)=E_ref*n*p_w/1000000；芯片、die、逻辑NPU和模组计数先校准。",
    "inverse_power_threshold": "P_total_w_max(C) = 1000000*C/E_ref。",
    "interpretation": "曲线上方才可能在相同SLO与质量下超过基准能效，且仍需实际轨迹、功耗和内存验证。曲线仅给出待实测门槛，不是Ascend能力预测。",
    "missing_data_policy": "缺乏功率或轨迹实测时，只报告变量曲线和所需并发/允许功率门槛，不提供绝对能力点估计，也不将TDP作实测。",
    "normalization_warning": "MW为单位归一化，未验证MW规模集群的线性扩展；P/D所有节点和角色功耗均需计入。"
  },
  "counting_and_unit_checks": [
    "GB按10^9 B、GiB按2^30 B分别列示，不混用。",
    "统计功耗时选定唯一物理边界，die/逻辑NPU/板卡/模组不得重复计数。",
    "多die模组若已有整体功率，不能再按die数重复乘；只给逻辑NPU数时必须核对其与模组数映射。",
    "P/D两角色、多节点、额外投机解码设备均计入功率；同一设备无重复乘卡数。",
    "单副本checkpoint、分片、副本、offload和草稿加载状态各自记录。"
  ]
}
